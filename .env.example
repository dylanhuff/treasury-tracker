# Database credentials (populated by deploy pipeline, copy to .env for local dev)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=treasury_db

# Service ports (defaults: postgres=5432, frontend=80)
# POSTGRES_PORT=5432
# FRONTEND_PORT=3080

# Frontend API URL (empty string uses relative URLs via nginx proxy)
# VITE_API_URL=http://localhost:8080

# Deploy target (required for deploy.sh)
# DEPLOY_HOST=user@host
# DEPLOY_DIR=/path/to/app
# DEPLOY_TUNNEL_NETWORK=my_tunnel_network

# CORS Configuration (optional, comma-separated)
# CORS_ALLOWED_ORIGINS=http://example.com,https://example.com
